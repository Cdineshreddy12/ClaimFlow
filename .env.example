# --- Supabase (Postgres, Auth) ---
# Project URL and keys from your Supabase project settings. Use the Mumbai
# (ap-south-1) region for DPDP data-residency.
# Required server-side too, not just for reference: apps/api verifies real
# Supabase-issued tokens against this project's public JWKS
# (SUPABASE_URL/auth/v1/.well-known/jwks.json) — see
# apps/api/src/lib/supabase-jwt.ts. Also read the organization_id/role
# custom claims stamped by the Custom Access Token hook — see
# apps/api/src/db/migrations/0002_custom_access_token_hook.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is API-only, never shipped to the web app. Bypasses RLS —
# see docs/adr/0002-authorization-and-tenant-isolation.md before using it.
SUPABASE_SERVICE_ROLE_KEY=
# NOT the project's real signing key (this project signs with an
# asymmetric key now, verified via JWKS above — there is no single shared
# secret for real tokens anymore). This is only for
# apps/api/scripts/mint-dev-token.ts, a local-only HS256 bridge used when
# there's no real Supabase session to test with; hard-rejected outside
# NODE_ENV=development. Any random string works for local dev.
SUPABASE_JWT_SECRET=

# Direct Postgres connection (the `postgres` superuser), used by Drizzle
# for schema migrations and queries. This ALSO bypasses RLS — same caveat
# as the service-role key above, see docs/adr/0002. URL-encode special
# characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Object storage (scanned documents, merged PDF packets) ---
# Staging bucket: zopkit-staging-claimflow-documents (ap-south-1, private,
# AES256 at rest). Use an IAM user scoped to only this bucket's ARN —
# never a broad deployment-manager credential, since this key ends up on
# developer machines and in local .env files.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OCR (handwritten doctor's notes) ---
AWS_TEXTRACT_REGION=ap-south-1

# --- AI classification, field extraction, query summarization ---
# When set, uploaded documents are classified by reading them (Claude
# vision for scans, PDF input for forms). When empty, a filename-matching
# heuristic runs instead — see docs/adr/0003. Either way a human confirms
# the slot, and the UI names which classifier produced the suggestion.
ANTHROPIC_API_KEY=

# --- API server ---
PORT=4000
NODE_ENV=development

# --- Web app (vite) ---
# Vite only exposes vars prefixed VITE_ to client code — see
# apps/web/vite.config.ts, which points envDir at the repo root so the web
# app reads this same file instead of needing its own.
VITE_API_URL=http://localhost:4000
# Same project URL/anon key as above, duplicated under VITE_ because Vite
# won't expose the bare names to client code. The anon key is designed to
# be public (RLS-gated) — safe in a shipped bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# DEV-ONLY shortcut: when set, the web app uses this token instead of a
# real Supabase session — skips signing in every time you restart the dev
# server. Mint one against a seeded org_members row with:
#   cd apps/api && pnpm dev:token <organizationId> <role> [userId]
# Leave unset to use the real sign-up/login flow and your actual session.
VITE_DEV_TOKEN=
