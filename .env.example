# --- Supabase (Postgres, Auth) ---
# Project URL and keys from your Supabase project settings. Use the Mumbai
# (ap-south-1) region for DPDP data-residency.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is API-only, never shipped to the web app. Bypasses RLS —
# see docs/adr/0002-authorization-and-tenant-isolation.md before using it.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings. Used by apps/api to verify
# Supabase-issued access tokens (HS256) and read the organization_id/role
# custom claims stamped by the Custom Access Token hook — see
# apps/api/src/db/migrations/0002_custom_access_token_hook.sql.
SUPABASE_JWT_SECRET=

# Direct Postgres connection (the `postgres` superuser), used by Drizzle
# for schema migrations and queries. This ALSO bypasses RLS — same caveat
# as the service-role key above, see docs/adr/0002. URL-encode special
# characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Object storage (scanned documents, merged PDF packets) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OCR (handwritten doctor's notes) ---
AWS_TEXTRACT_REGION=ap-south-1

# --- AI classification, field extraction, query summarization ---
ANTHROPIC_API_KEY=

# --- API server ---
PORT=4000
NODE_ENV=development
